{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": { "source": "github", "repo": "EveryInc/compound-engineering-plugin", "ref": "main" }
    },
    "superpowers-marketplace": {
      "source": { "source": "github", "repo": "obra/superpowers-marketplace", "ref": "main" }
    },
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail", "ref": "main" }
    },
    "taskboard": {
      "source": { "source": "github", "repo": "atebites-hub/taskboard", "ref": "main" }
    }
  },
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true,
    "superpowers@superpowers-marketplace": true,
    "ponytail@ponytail": true,
    "taskboard@taskboard": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/hooks/session-workflow-checklist.sh\"",
            "timeout": 10,
            "statusMessage": "Loading PJTemplate workflow checklist..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/scripts/check-task-compliance.sh\" --task || exit 2"
          }
        ]
      }
    ]
  }
}
