{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash .cursor/hooks/session-workflow.sh",
        "timeout": 10
      },
      {
        "command": "bash .cursor/hooks/taskboard-session.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "bash .cursor/hooks/task-compliance-stop.sh",
        "timeout": 60
      },
      {
        "command": "bash .cursor/hooks/taskboard-commit.sh",
        "timeout": 15
      }
    ]
  }
}