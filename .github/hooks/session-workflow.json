{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "PJ_HOOK_FORMAT=copilot bash scripts/hooks/session-workflow-checklist.sh",
        "powershell": "$env:PJ_HOOK_FORMAT='copilot'; bash scripts/hooks/session-workflow-checklist.sh",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "scripts/check-task-compliance.sh --task || exit 2",
        "powershell": "bash scripts/check-task-compliance.sh --task; if ($LASTEXITCODE -ne 0) { exit 2 }",
        "timeoutSec": 60
      }
    ]
  }
}