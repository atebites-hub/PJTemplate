# Dependencies
node_modules/
*.log
.env
logs/current/*
!logs/current/.gitkeep
logs/archive/*
!logs/archive/.gitkeep
config/secrets/*
!config/secrets/README.md

# Builds
dist/
build/
site/
*.min.js

# Tests
coverage/
.nyc_output/
.ruff_cache/
.coverage
.coverage.*

# OS
Thumbs.db
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.venv-ci/

# Jupyter (dev notebooks)
.ipynb_checkpoints/
notebooks/data/**
!notebooks/data/**/.gitkeep

# General
*.tmp
*.bak

# Agent tooling (commit .agents/settings.json; keep personal overrides local)
.agents/settings.local.json
.claude/settings.local.json
.agents/scheduled_tasks.lock

# Task memories are kept local by default so the template ships clean. The memory
# system still works per-clone; to version-control your project's task memories
# (recommended for team retrieval), delete the next two lines.
docs/memories/*.md
!docs/memories/.gitkeep

# GitNexus runtime artifacts (the code graph + packed bundles)
.gitnexus/
gitnexus-*.tgz
